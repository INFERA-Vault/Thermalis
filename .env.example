# Database Configuration
ENVIRONMENT=production
DEBUG=False
JWT_SECRET_KEY=replace_with_a_long_random_secret
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=secure_database_password_here
POSTGRES_DB=geospatial_fires_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# NASA FIRMS API Key (Backend Only)
FIRMS_API_KEY=your_nasa_firms_key_here

# MapTiler API Key (Frontend Build Time)
VITE_MAPTILER_API_KEY=your_maptiler_key_here

# Frontend configuration
VITE_API_URL=http://localhost:8001/api/v1
# Set true only when FIRMS_API_KEY is configured for the backend.
VITE_LIVE_REFRESH_ENABLED=false
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Alert email notifications (disabled by default)
ALERT_EMAIL_ENABLED=False
ALERT_EMAIL_TO=recipient@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=alerts@example.com
FRONTEND_URL=http://localhost:8080

# Emergency dispatch is fail-closed and disabled by default.
# Configure verified recipients through the protected /api/v1/emergency/recipients API.
EMERGENCY_DISPATCH_ENABLED=False
EMERGENCY_ADMIN_KEY=replace_with_a_long_random_operator_key
EMERGENCY_MIN_SEVERITY=HIGH
EMERGENCY_DEFAULT_RADIUS_METERS=5000
EMERGENCY_MAX_RECIPIENTS=20
EMERGENCY_REQUEST_TIMEOUT_SECONDS=10

# Twilio is required only for SMS and voice calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_API_BASE=https://api.twilio.com/2010-04-01
