# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env with sensitive credentials.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Industrial Fire & Thermal Anomaly Detection System"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# Server Settings
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database (PostgreSQL + PostGIS)
# Example: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/geospatial_fires_db"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# NASA FIRMS API (For future ingestion module)
# Register at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=""

# OpenStreetMap / Overpass API (For future infrastructure module)
OVERPASS_URL="https://overpass-api.de/api/interpreter"
OVERPASS_TIMEOUT=60
