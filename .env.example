# Database Configuration
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=secure_database_password_here
POSTGRES_DB=geospatial_fires_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# NASA FIRMS API Key (Backend Only)
FIRMS_API_KEY=your_nasa_firms_key_here

# MapTiler API Key (Frontend Build Time)
VITE_MAPTILER_API_KEY=your_maptiler_key_here

# Frontend configuration
VITE_API_URL=http://localhost:8001
# CORS Configuration
# The backend defaults to allowing localhost:5173-5176.
# To override for production or custom ports, provide a comma-separated list:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Alert Email Configuration
ALERT_EMAIL_ENABLED=False
ALERT_EMAIL_TO=recipient@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=alerts@example.com
